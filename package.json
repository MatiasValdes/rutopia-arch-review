{
  "name": "rutopia-arch-review",
  "private": true,
  "type": "module",
  "description": "Architecture review agent for MatiasValdes/rutopia_backend PRs",
  "scripts": {
    "check": "tsc --noEmit",
    "validate": "agent-sdk validate --dir .",
    "playground": "agent-sdk dev --dir .",
    "eval": "agent-sdk eval --dir .",
    "deploy:dry": "agent-sdk deploy --dir . --dry-run --json",
    "deploy": "agent-sdk deploy --dir . --cursor-events-repo MatiasValdes/rutopia_backend"
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
